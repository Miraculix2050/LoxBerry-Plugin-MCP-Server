#!/bin/bash
set -u

failed=0
description="Checks that the MCP server is available and its local data can be used."
result=""

# LoxBerry invokes this executable with either "title" or "check".  A plugin
# healthcheck must return its title or three fields (description, status, result),
# respectively; arbitrary log lines are interpreted as those fields.
case "${1:-check}" in
    title)
        printf '%s\n' "$description"
        exit 0
        ;;
    check)
        ;;
    *)
        printf '%s\n%s\n%s\n' "$description" 3 "Unsupported healthcheck action."
        exit 1
        ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
actual_folder=$(basename -- "$script_dir")
plugin_config="${LBPCONFIG:?}/$actual_folder"
plugin_data="${LBPDATA:?}/$actual_folder"

check() {
    check_description=$1
    shift
    if "$@"; then
        if [ -n "$result" ]; then
            result="$result; "
        fi
        result="${result}${check_description}: OK"
    else
        if [ -n "$result" ]; then
            result="$result; "
        fi
        result="${result}${check_description}: failed"
        failed=1
    fi
}

check "MCP server service" systemctl is-active --quiet loxberry-mcpserver.service
check "MCP server health endpoint" curl --fail --silent --max-time 3 --output /dev/null http://127.0.0.1:8765/healthz
check "Plugin configuration" test -r "$plugin_config/mcpserver.json"
check "OAuth data directory" test -d "$plugin_data/auth"
check "OAuth data directory permissions" test -w "$plugin_data/auth"

if [ "$failed" -ne 0 ]; then
    printf '%s\n%s\n%s\n' "$description" 3 "$result. No repair action was taken."
    exit 1
fi
printf '%s\n%s\n%s\n' "$description" 5 "$result."
