#!/bin/bash
set -u

failed=0
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
actual_folder=$(basename -- "$script_dir")
plugin_config="${LBPCONFIG:?}/$actual_folder"
plugin_data="${LBPDATA:?}/$actual_folder"
check() {
    description=$1
    shift
    if "$@"; then
        echo "OK: $description"
    else
        echo "FAIL: $description"
        failed=1
    fi
}

check "MCP server service is active" systemctl is-active --quiet loxberry-mcpserver.service
check "MCP server health endpoint responds" curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8765/healthz
check "Plugin configuration is readable" test -r "$plugin_config/mcpserver.json"
check "OAuth data directory exists" test -d "$plugin_data/auth"
check "OAuth data directory is writable" test -w "$plugin_data/auth"

if [ "$failed" -ne 0 ]; then
    echo "<ERROR> LoxBerry MCP Server health check failed. No repair was attempted."
    exit 1
fi
echo "<OK> LoxBerry MCP Server health check passed."
